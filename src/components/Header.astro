---
import { localePath, WA_DEFAULT, type Lang } from '../lib/site';
import { NAV, UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Caminho equivalente no outro idioma, sem prefixo. Vem do Base. */
  altBare: string;
}
const { lang, altBare } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/92 backdrop-blur-sm">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href={localePath(lang)}
      class="flex items-baseline gap-2 text-[1.05rem] font-semibold tracking-tight"
      aria-label="Etter"
    >
      Etter
      <span class="h-1.5 w-1.5 translate-y-[-0.1em] rounded-full bg-signal dot-live" aria-hidden="true"></span>
    </a>

    <nav class="hidden items-center gap-7 text-[0.9rem] md:flex" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
      {
        NAV[lang].map((item) => {
          const href = localePath(lang, item.path);
          const active = current === href || current.startsWith(href + '/');
          return (
            <a
              href={href}
              class:list={['transition-colors hover:text-signal', active ? 'text-ink' : 'text-ash']}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={localePath(other, altBare)}
        class="hidden text-[0.82rem] text-ash transition-colors hover:text-ink sm:block"
        hreflang={other === 'pt' ? 'pt-BR' : 'en'}
      >
        {t.langSwitch}
      </a>
      <a
        href={WA_DEFAULT[lang]}
        rel="noopener"
        target="_blank"
        class="rounded-full bg-ink px-4 py-2 text-[0.85rem] font-medium text-paper transition-colors hover:bg-signal"
      >
        {t.cta}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="md:hidden"
        aria-label={t.menu}
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 7h16M3 15h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" hidden class="border-t border-rule md:hidden" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
    <div class="shell flex flex-col py-2">
      {
        NAV[lang].map((item) => (
          <a href={localePath(lang, item.path)} class="border-b border-rule/60 py-3 text-[0.95rem] last:border-0">
            {item.label}
          </a>
        ))
      }
      <a href={localePath(other, altBare)} class="py-3 text-[0.95rem] text-ash">{t.langSwitch}</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
