        <a href={WA} target="_blank" rel="noopener" class="btn btn-wa big">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waIcon}/></svg>
          Falar com o Enzo no WhatsApp
        </a>
