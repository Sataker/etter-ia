---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Faq from '../../components/Faq.astro';
import enzo from '../../assets/enzo-sf.jpg';
import { SITE } from '../../lib/site';

const lang = 'en' as const;
const updated = '2026-09-07';

const answer =
  'Etter is run by Enzo Vaccaro, a Brazilian developer specialised in AI agents and process automation. He spent two months in San Francisco, in Silicon Valley, and currently keeps more than 19 AI agents in production for Brazilian companies and professionals. Clients talk directly to the person who builds, with no sales layer in between.';

const faq = [
  {
    q: 'Who is behind Etter?',
    a: 'Enzo Vaccaro, a developer specialised in AI agents and automation. He runs the diagnosis, the development and the follow-up — clients speak directly with the person building, not with a commercial intermediary.',
  },
  {
    q: 'What size of company does Etter work with?',
    a: 'Small and medium companies and independent professionals with a running operation. The criterion is not revenue, it is having a repetitive process with enough volume for automation to pay for itself.',
  },
  {
    q: 'Does Etter work outside Brazil?',
    a: 'The focus is the Brazilian market, working remotely across the country. International projects are assessed case by case, in English.',
  },
  {
    q: 'Is data stored in third-party clouds?',
    a: 'It depends on the project and the client requirements. When confidentiality is critical — health data, for example — the system runs on dedicated infrastructure without passing through third-party clouds. Source code and databases always belong to the client.',
  },
];

const schema = [
  { '@type': 'AboutPage', name: 'About Etter', description: answer },
  {
    '@type': 'Person',
    '@id': `${SITE.url}/#enzo`,
    name: 'Enzo Vaccaro',
    jobTitle: 'AI agent and automation developer',
    worksFor: { '@id': `${SITE.url}/#organization` },
    knowsAbout: [
      'Artificial intelligence agents',
      'Process automation',
      'WhatsApp Business API',
      'Application development',
      'Systems integration',
    ],
    email: SITE.email,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="About Etter — who builds the AI agents"
  description="Etter is run by Enzo Vaccaro, an AI agent and automation developer with more than 19 agents in production and two months of immersion in Silicon Valley."
  updated={updated}
  schema={schema}
  breadcrumbs={[{ name: 'About', path: 'about' }]}
>
  <header class="pt-12 pb-10 md:pt-16">
    <div class="shell grid gap-10 md:grid-cols-[1.3fr_1fr] md:items-start md:gap-14">
      <div class="max-w-[62ch]">
        <h1 class="text-[length:var(--text-h2)] leading-[1.06]">You talk to the person who builds it</h1>
        <p class="mt-7 border-l-2 border-signal pl-5 text-[1.08rem] leading-relaxed text-ink-soft">{answer}</p>
        <p class="mt-6 font-mono text-[0.74rem] text-ash">Reviewed on {updated}</p>
      </div>

      <figure>
        <Image
          src={enzo}
          alt="Enzo Vaccaro on the Golden Gate Bridge, San Francisco"
          widths={[400, 600, 800, 1215]}
          sizes="(max-width: 768px) 92vw, 380px"
          quality={82}
          class="w-full rounded-lg"
          loading="eager"
        />
        <figcaption class="mt-3 font-mono text-[0.72rem] text-ash">
          San Francisco, Silicon Valley — two months of immersion
        </figcaption>
      </figure>
    </div>
  </header>

  <Section title="How this started">
    <div class="mt-8 grid max-w-none gap-10 md:grid-cols-2">
      <div class="max-w-[60ch] space-y-4 text-[1.02rem] leading-relaxed text-ink-soft">
        <p>
          The turning point was not discovering artificial intelligence — it was realising you could build systems
          that keep working after you close the laptop. Automation stops being a time saving and becomes a new
          capability: the company serves customers at an hour when nobody is there.
        </p>
        <p>
          The two months in San Francisco changed less about the technical side and more about the standard.
          There, what separates a project that works from one that impresses in a demo is the operation after
          delivery — who tunes it when the system gets something wrong, and how fast.
        </p>
        <p>
          Today that means more than 19 agents in production for clinics, nutritionists, personal trainers,
          barbershops, online stores and consultancies across Brazil.
        </p>
      </div>

      <dl class="grid grid-cols-2 gap-px self-start overflow-hidden rounded-lg border border-rule bg-rule">
        <div class="bg-paper p-6">
          <dt class="text-[0.8rem] text-ash">Agents in production</dt>
          <dd class="tnum mt-1.5 text-[1.9rem] font-semibold leading-none">19+</dd>
        </div>
        <div class="bg-paper p-6">
          <dt class="text-[0.8rem] text-ash">Silicon Valley</dt>
          <dd class="tnum mt-1.5 text-[1.9rem] font-semibold leading-none">2 months</dd>
        </div>
        <div class="bg-paper p-6">
          <dt class="text-[0.8rem] text-ash">Coverage</dt>
          <dd class="mt-1.5 text-[1.9rem] font-semibold leading-none">Brazil</dd>
        </div>
        <div class="bg-paper p-6">
          <dt class="text-[0.8rem] text-ash">Sales intermediaries</dt>
          <dd class="mt-1.5 text-[1.9rem] font-semibold leading-none">None</dd>
        </div>
      </dl>
    </div>
  </Section>

  <Section title="How I work">
    <ul class="mt-8 grid max-w-none gap-8 md:grid-cols-2">
      <li>
        <h3 class="text-[1.08rem] font-semibold">Scope fixed before work starts</h3>
        <p class="mt-2 max-w-[52ch] text-[0.98rem] leading-relaxed text-ash">
          Timeline and price defined in the proposal. A budget that grows with every conversation is a sign of a
          bad diagnosis.
        </p>
      </li>
      <li>
        <h3 class="text-[1.08rem] font-semibold">The code is yours</h3>
        <p class="mt-2 max-w-[52ch] text-[0.98rem] leading-relaxed text-ash">
          Source code and database belong to the client. No platform lock-in.
        </p>
      </li>
      <li>
        <h3 class="text-[1.08rem] font-semibold">I turn down projects that will not work</h3>
        <p class="mt-2 max-w-[52ch] text-[0.98rem] leading-relaxed text-ash">
          When volume does not justify it, or the process still changes weekly, the right move is saying so
          upfront — not finding out together six months later.
        </p>
      </li>
      <li>
        <h3 class="text-[1.08rem] font-semibold">Delivery is not the end</h3>
        <p class="mt-2 max-w-[52ch] text-[0.98rem] leading-relaxed text-ash">
          Automation without maintenance ages: prices change, policies change, and the automated answer becomes
          wrong. Continuous tuning is part of the work.
        </p>
      </li>
    </ul>
  </Section>

  <Faq lang={lang} items={faq} />
  <CtaBlock lang={lang} />
</Base>
