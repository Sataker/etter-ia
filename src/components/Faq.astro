---
import { UI } from '../i18n/ui';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
  items: { q: string; a: string }[];
  title?: string;
}
const { lang, items, title } = Astro.props;
---

{
  items.length > 0 && (
    <section class="rule-top py-16 md:py-24">
      <div class="shell max-w-3xl">
        <h2 class="text-[length:var(--text-h2)] leading-[1.08]">{title ?? UI[lang].faq}</h2>
        <div class="mt-8 border-t border-rule">
          {items.map((item) => (
            <details class="group border-b border-rule py-5">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[1.02rem] font-medium marker:content-none">
                <span>{item.q}</span>
                <span
                  class="mt-1 shrink-0 text-ash transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 1v12M1 7h12" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 max-w-[68ch] text-[0.98rem] leading-relaxed text-ash">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
