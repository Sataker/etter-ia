---
import { SITE, WA_DEFAULT, type Lang } from '../lib/site';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  body?: string;
}
const { lang, title, body } = Astro.props;
const t = UI[lang];
---

<section class="rule-top py-16 md:py-24">
  <div class="shell grid gap-8 md:grid-cols-[1.3fr_1fr] md:items-end">
    <div class="max-w-xl">
      <h2 class="text-[length:var(--text-h2)] leading-[1.08]">{title ?? t.talkTitle}</h2>
      <p class="mt-4 text-[1.02rem] leading-relaxed text-ash">{body ?? t.talkBody}</p>
    </div>
    <div class="flex flex-col gap-3">
      <a
        href={WA_DEFAULT[lang]}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-ink px-6 py-3.5 text-center font-medium text-paper transition-colors hover:bg-signal"
      >
        {t.ctaLong}
      </a>
      <a href={`mailto:${SITE.email}`} class="text-center text-[0.92rem] text-ash link-underline">
        {SITE.email}
      </a>
    </div>
  </div>
</section>
