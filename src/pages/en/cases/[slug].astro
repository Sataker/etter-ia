---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CaseArticle from '../../../components/CaseArticle.astro';
import { faqSchema, serviceSchema, articleSchema, caseSchema } from '../../../lib/schema';
import { LABEL, SEG } from '../../../lib/routes';

export async function getStaticPaths() {
  const entries = await getCollection('cases', (e) => e.data.lang === 'en');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const lang = 'en' as const;
const { Content } = await render(entry);
const d = entry.data;

const extra = [
  'cases' === 'services' ? serviceSchema(d) : null,
  'cases' === 'cases' ? caseSchema(d) : null,
  'cases' === 'guides' || 'cases' === 'industries' ? articleSchema(d, lang, Astro.url.href) : null,
  faqSchema(d.faq),
].filter(Boolean) as Record<string, unknown>[];

const relatedCase =
  'cases' === 'industries' && d.caseRef
    ? (await getCollection('cases', (e) => e.data.lang === lang && e.data.slug === d.caseRef))[0]
    : undefined;
---

<Base title={d.seoTitle} description={d.description} updated={d.updated} schema={extra}
  breadcrumbs={[{ name: LABEL[lang].cases, path: SEG[lang].cases }, { name: d.title, path: `${SEG[lang].cases}/${d.slug}` }]}>
  <CaseArticle lang={lang} entry={entry} relatedCase={relatedCase}>
    <Content />
  </CaseArticle>
</Base>
