---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { hub } from '../../lib/hubs';
import { SEG, LABEL } from '../../lib/routes';
import { SITE } from '../../lib/site';

const lang = 'pt' as const;
const h = hub('industries', lang);
const entries = (await getCollection('industries', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const schema = {
  '@type': 'CollectionPage',
  name: h.title,
  description: h.answer,
  hasPart: entries.map((e) => ({
    '@type': 'WebPage',
    name: e.data.title,
    description: e.data.description,
    url: new URL(`/${SEG[lang].industries}/${e.data.slug}`, SITE.url).href,
  })),
};
---

<Base title={h.seoTitle} description={h.description} updated="2026-09-07" schema={schema}
  breadcrumbs={[{ name: LABEL[lang].industries, path: SEG[lang].industries }]}>
  <IndexList lang={lang} title={h.title} lead={h.lead} answer={h.answer}
    basePath={SEG[lang].industries} entries={entries} variant="card" />
</Base>
