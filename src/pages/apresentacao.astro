---
import '@fontsource-variable/archivo/index.css';
import { Image } from 'astro:assets';
import enzoSf from '../assets/enzo-sf.jpg';
import enzoPerfil from '../assets/enzo-perfil.jpg';
import logoPeak from '../assets/logo-peak.png';
import logoCyber from '../assets/logo-cyber.png';
import logoApp from '../assets/logo-app-nutricao.png';
import { SITE, wa } from '../lib/site';

/*
  Página de apresentação: link que se manda para uma empresa, não página de busca.
  Visual próprio (azul, fotos, telas simuladas) — o site principal segue o estilo documento.
  Fica fora do índice e do sitemap. Só número que o cliente confirmou entra aqui.
  v3 (26/11/2026): estrutura inspirada em Sierra, Decagon e Morningside AI — resultado no topo,
  "por que a IA não saiu do papel", calculadora do custo do trabalho repetido, método em 3 fases.
*/
const WA = wa('Olá Enzo! Vi a apresentação da Etter e quero conversar sobre um processo da minha empresa.');
const canonical = `${SITE.url}/apresentacao`;
const title = 'Etter — IA funcionando dentro da sua empresa';
const description =
  'A Etter coloca IA para atender no WhatsApp, montar compras e entregar relatórios dentro dos sistemas que a sua empresa já usa. Casos reais, com nome e número.';

const waIcon =
  'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z';

const proof = [
  { value: '214 mil', label: 'conversas atendidas em 30 dias', who: 'Peak Performance' },
  { value: '+50%', label: 'na taxa de fechamento', who: 'Peak Performance' },
  { value: '5 dias → 3 h', label: 'para montar a compra do estoque', who: 'Cyber Nutrition' },
  { value: '20 → 4', label: 'nutricionistas para a mesma operação', who: 'App de nutrição' },
];

const pains = [
  { icon: 'moon', t: 'Cliente sem resposta', d: 'A mensagem chega às 23h e só é respondida no dia seguinte. Até lá, ele já fechou com outro.' },
  { icon: 'copy', t: 'Trabalho digitado duas vezes', d: 'O pedido chega no WhatsApp, vai para a planilha e é digitado de novo no sistema.' },
  { icon: 'lock', t: 'Tudo para em você', d: 'Aprovação, conferência, relatório: se o dono não olha, não anda.' },
];

const cases = [
  {
    client: 'Peak Performance',
    logo: logoPeak,
    tile: 'dark',
    sector: 'Rede de consultorias do mercado fitness',
    before: '45 números de WhatsApp lotados. O vendedor passava o dia respondendo curioso, e quem queria comprar esperava na fila.',
    after: 'A IA responde cada pessoa na hora, faz as perguntas que o vendedor faria e passa para ele só quem quer comprar.',
    stays: 'O fechamento continua com o vendedor, que já recebe a conversa inteira.',
    results: [
      { value: '214 mil', label: 'conversas em 30 dias' },
      { value: '+50%', label: 'na taxa de fechamento' },
    ],
  },
  {
    client: 'Cyber Nutrition',
    logo: logoCyber,
    tile: 'light',
    sector: 'E-commerce de nutrição esportiva',
    before: 'A compra do estoque era montada à mão, cruzando venda, estoque e o que já estava a caminho. Levava 5 dias.',
    after: 'Todo dia a IA lê o Bling, confere o estoque, desconta o que já foi pedido e deixa a lista de compra pronta.',
    stays: 'O dono abre a lista, confere e aprova. Nenhuma compra sai sem ele.',
    results: [{ value: '5 dias → 3 h', label: 'para cada rodada de compra' }],
  },
  {
    client: 'App de nutrição',
    logo: logoApp,
    tile: 'dark',
    sector: 'Plataforma de experts, US$ 50 mil por mês',
    before: 'Cada plano de dieta e treino era escrito do zero por um nutricionista, paciente a paciente.',
    after: 'A IA lê a anamnese e sugere a dieta e o treino seguindo o método da empresa.',
    stays: 'O nutricionista revisa e aprova, em vez de escrever o plano inteiro.',
    results: [{ value: '20 → 4', label: 'nutricionistas na equipe' }],
  },
];

const phases = [
  {
    n: '01',
    t: 'Diagnóstico',
    d: 'Uma conversa de 30 minutos sobre como o trabalho anda hoje. Você recebe por escrito o que vale automatizar, o que não vale, o valor e o prazo.',
    tag: 'Sem custo',
  },
  {
    n: '02',
    t: 'Construção',
    d: 'A IA é montada com as regras, os preços e o jeito de falar da sua empresa, ligada aos sistemas que você já usa. Você testa antes de ir ao ar.',
    tag: 'Valor fechado',
  },
  {
    n: '03',
    t: 'Operação',
    d: 'Depois que está rodando, eu acompanho os números, treino a equipe e ajusto quando o negócio muda. Não entrego e sumo.',
    tag: 'Acompanhamento',
  },
];

const compare = [
  { them: 'Pacote pronto, igual para todo mundo', us: 'Montado em cima de como a sua empresa já trabalha' },
  { them: 'Você fala com o vendedor; quem constrói é outro', us: 'Você fala direto com quem constrói' },
  { them: 'Fica preso à plataforma da agência', us: 'O que foi construído é da sua empresa' },
  { them: 'Entrega e some', us: 'Acompanha os números depois que vai ao ar' },
  { them: 'Promete tudo automático', us: 'Onde o erro custa caro, uma pessoa aprova' },
];

const faq = [
  {
    q: 'Quanto custa?',
    a: 'Depende do processo. Depois da conversa você recebe uma proposta com valor e prazo fechados, antes de qualquer trabalho começar. Se não compensar, eu digo.',
  },
  {
    q: 'Preciso trocar os sistemas que já uso?',
    a: 'Não. A IA trabalha em cima do que a empresa já usa: WhatsApp, ERP, planilha, agenda, CRM.',
  },
  {
    q: 'E se a IA errar?',
    a: 'Onde o erro custa caro, quem decide é uma pessoa: a IA prepara, alguém da equipe aprova. E o acompanhamento depois da entrega existe justamente para corrigir rápido.',
  },
  {
    q: 'Minha equipe vai ser substituída?',
    a: 'A IA tira o trabalho repetido da mesa das pessoas. Quem hoje copia pedido e responde a mesma pergunta 50 vezes passa a cuidar do cliente que vai comprar.',
  },
  {
    q: 'E os dados da minha empresa?',
    a: 'Ficam nos seus sistemas e nas suas contas. A IA só acessa o que o processo precisa, e o acesso pode ser retirado quando você quiser.',
  },
  {
    q: 'Funciona para empresa pequena?',
    a: 'O que importa não é o tamanho, é ter uma tarefa que se repete toda semana. Se não compensar automatizar, eu digo na primeira conversa.',
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1f4d" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  </head>

  <body>
    <!-- Topo -->
    <header class="top" id="top">
      <div class="wrap top-in">
        <a href="/" class="brand">Etter<span class="dot"></span></a>
        <nav class="nav" aria-label="Seções">
          <a href="#como-fica">Como funciona</a>
          <a href="#casos">Casos</a>
          <a href="#enzo">Quem sou</a>
        </nav>
        <a href={WA} target="_blank" rel="noopener" class="btn btn-ghost">Falar no WhatsApp</a>
      </div>
    </header>

    <!-- Hero -->
    <section class="hero">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span class="pulse"></span>Inteligência artificial em operação, não em palestra</p>
          <h1>A sua empresa atendendo, conferindo e vendendo <span>até de madrugada.</span></h1>
          <p class="lead">
            A Etter coloca IA para responder clientes no WhatsApp, montar compras e entregar relatórios — dentro dos
            sistemas que a sua empresa já usa. A sua equipe só aprova e fecha.
          </p>
          <div class="cta-row">
            <a href={WA} target="_blank" rel="noopener" class="btn btn-wa">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waIcon}/></svg>
              Agendar conversa de 30 min
            </a>
            <a href="#como-fica" class="btn btn-line">Ver a IA trabalhando</a>
          </div>
          <p class="mini">Sem custo e sem compromisso · Atendimento no Brasil inteiro</p>
        </div>

        <!-- Celular com conversa simulada (animada) -->
        <div class="phone-stage" aria-label="Exemplo de atendimento da IA no WhatsApp">
          <div class="phone">
            <div class="phone-bar">
              <span class="avatar-sm">L</span>
              <div><strong>Loja do cliente</strong><small class="status">online agora</small></div>
            </div>
            <div class="chat" id="chat">
              <p class="day">hoje</p>
              <p class="msg in" data-step="0">Oi! Vocês têm horário amanhã de manhã? <time>23:47</time></p>
              <p class="msg out" data-step="1">Olá! Tenho às 9h e às 10h30. Qual fica melhor para você? <time>23:47</time></p>
              <p class="msg in" data-step="2">9h, por favor <time>23:48</time></p>
              <p class="msg out" data-step="3">Pronto, marcado para amanhã às 9h. Mando um lembrete 1 hora antes. <time>23:48</time></p>
              <p class="typing" aria-hidden="true"><i></i><i></i><i></i></p>
            </div>
          </div>
          <div class="float f1"><span class="ok"></span>Respondido em 8 segundos</div>
          <div class="float f2"><span class="ok"></span>Horário salvo na agenda</div>
        </div>
      </div>

      <div class="wrap">
        <dl class="proof">
          {proof.map((p) => (
            <div>
              <dt>{p.value}</dt>
              <dd>{p.label}</dd>
              <dd class="who">{p.who}</dd>
            </div>
          ))}
        </dl>
        <p class="logos"><span>Já rodando em</span>{cases.map((c) => <Image src={c.logo} alt={c.client} height={96} class={c.tile === 'light' ? 'tall' : ''} />)}</p>
      </div>
    </section>

    <!-- Por que não saiu do papel -->
    <section class="sec story">
      <div class="wrap narrow">
        <p class="eyebrow">Talvez você já tenha passado por isso</p>
        <h2 class="reveal">Você já testou o ChatGPT. Já viu palestra, vídeo, curso de IA.</h2>
        <h2 class="reveal dim">E na segunda-feira a equipe continua copiando pedido do WhatsApp para a planilha.</h2>
        <p class="reveal story-p">
          Não é falta de ferramenta. O que falta é alguém entrar na operação, entender como o trabalho anda e
          colocar a IA para fazer a parte repetida <strong>todo dia</strong>, ligada aos sistemas da empresa. É isso que a Etter faz.
        </p>
      </div>
    </section>

    <!-- Dores -->
    <section class="sec soft">
      <div class="wrap">
        <p class="eyebrow">O trabalho que ninguém vê</p>
        <h2>Isso acontece na sua empresa?</h2>
        <div class="pains">
          {pains.map((p) => (
            <div class="pain reveal">
              <span class="ico" aria-hidden="true">
                {p.icon === 'moon' && <svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>}
                {p.icon === 'copy' && <svg viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>}
                {p.icon === 'lock' && <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>}
              </span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          ))}
        </div>

        <!-- Calculadora -->
        <div class="calc reveal" id="calc">
          <div class="calc-in">
            <div>
              <p class="eyebrow">Faça a conta</p>
              <h3>Quanto o trabalho repetido custa hoje?</h3>
              <p class="calc-sub">Pense numa tarefa só: responder a mesma pergunta, digitar pedido, montar relatório.</p>
              <label>
                <span>Pessoas fazendo essa tarefa <output id="o-p">2</output></span>
                <input type="range" id="i-p" min="1" max="20" value="2" />
              </label>
              <label>
                <span>Horas por semana, cada uma <output id="o-h">10 h</output></span>
                <input type="range" id="i-h" min="1" max="40" value="10" />
              </label>
              <label>
                <span>Custo mensal de cada pessoa, com encargos <output id="o-c">R$ 3.500</output></span>
                <input type="range" id="i-c" min="1500" max="15000" step="250" value="3500" />
              </label>
            </div>
            <div class="calc-out" aria-live="polite">
              <small>Essa tarefa custa por ano</small>
              <b id="r-y">R$ 20.700</b>
              <span id="r-h">87 horas por mês</span>
              <p>É o valor pago hoje para fazer o que uma IA bem montada pode preparar sozinha. Quanto disso dá para tirar da mesa, a gente descobre na conversa.</p>
              <a href={WA} target="_blank" rel="noopener" class="btn btn-wa">Quero ver essa conta na minha empresa</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Como fica na empresa -->
    <section class="sec" id="como-fica">
      <div class="wrap">
        <p class="eyebrow">Na prática</p>
        <h2>Veja como fica dentro da sua empresa</h2>
        <p class="note">Telas de exemplo, para mostrar o formato.</p>

        <div class="row reveal">
          <div class="row-text">
            <span class="tag">1 · Atendimento</span>
            <h3>O cliente é respondido na hora, a qualquer hora</h3>
            <p>A IA responde no WhatsApp da empresa, tira dúvida, marca horário e faz as perguntas que o vendedor faria. Quem está pronto para comprar chega para a sua equipe com a conversa inteira.</p>
            <ul class="checks">
              <li>Responde de madrugada e no fim de semana</li>
              <li>Usa as informações e as regras da sua empresa</li>
              <li>Chama uma pessoa quando o cliente precisa de gente</li>
            </ul>
          </div>
          <div class="card mock">
            <div class="mock-head"><span>Painel de atendimento</span><span class="live">ao vivo</span></div>
            <div class="lead-row"><b>Mariana S.</b><span class="pill hot">Pronta para comprar</span><small>passada ao vendedor · 02:14</small></div>
            <div class="lead-row"><b>Carlos R.</b><span class="pill">Tirou dúvida de preço</span><small>respondido pela IA · 01:51</small></div>
            <div class="lead-row"><b>Juliana P.</b><span class="pill done">Horário marcado</span><small>amanhã, 9h · 23:48</small></div>
            <div class="lead-row"><b>Pedro A.</b><span class="pill">Pediu catálogo</span><small>enviado pela IA · 23:12</small></div>
          </div>
        </div>

        <div class="row rev reveal">
          <div class="row-text">
            <span class="tag">2 · Processos internos</span>
            <h3>A tarefa da semana chega pronta, só para aprovar</h3>
            <p>Compra de estoque, conferência de pedidos, cobrança de documentos: a IA cruza os dados do seu sistema e prepara o trabalho. A decisão continua com você.</p>
            <ul class="checks">
              <li>Lê o ERP, a planilha ou o sistema que você já usa</li>
              <li>Confere tudo antes de sugerir</li>
              <li>Nada sai sem a sua aprovação</li>
            </ul>
          </div>
          <div class="card mock">
            <div class="mock-head"><span>Lista de compra · hoje, 05:30</span><span class="live">pronta</span></div>
            <table class="buy">
              <thead><tr><th>Produto</th><th>Estoque</th><th>Comprar</th></tr></thead>
              <tbody>
                <tr><td>Whey 900g baunilha</td><td>12</td><td><b>48</b></td></tr>
                <tr><td>Creatina 300g</td><td>4</td><td><b>60</b></td></tr>
                <tr><td>Pré-treino 300g</td><td>31</td><td><b>0</b></td></tr>
                <tr><td>Barra proteica cx 12</td><td>9</td><td><b>24</b></td></tr>
              </tbody>
            </table>
            <div class="approve"><span>132 produtos conferidos</span><button type="button" tabindex="-1">Aprovar compra</button></div>
          </div>
        </div>

        <div class="row reveal">
          <div class="row-text">
            <span class="tag">3 · Números</span>
            <h3>O relatório chega no seu WhatsApp toda manhã</h3>
            <p>Vendas, atendimentos, faltas, estoque: os números que hoje estão espalhados em vários sistemas chegam juntos, prontos, sem ninguém montar planilha.</p>
            <ul class="checks">
              <li>Junta dados de vários sistemas</li>
              <li>Avisa quando algo foge do normal</li>
              <li>No WhatsApp ou no e-mail, no horário que você escolher</li>
            </ul>
          </div>
          <div class="card mock report">
            <div class="mock-head"><span>Resumo de ontem · 07:00</span><span class="live">enviado</span></div>
            <div class="kpis">
              <div><small>Atendimentos</small><b>186</b></div>
              <div><small>Vendas</small><b>23</b></div>
              <div><small>Faltas</small><b>2</b></div>
            </div>
            <div class="bars" aria-hidden="true">
              {[38, 52, 45, 61, 58, 74, 69].map((h) => <span style={`--h:${h}%`}></span>)}
            </div>
            <p class="alert">Atenção: creatina acaba em 3 dias no ritmo atual.</p>
          </div>
        </div>

        <p class="works">
          <span>Funciona com o que você já usa</span>
          <b>WhatsApp</b><b>Instagram</b><b>Bling</b><b>Planilhas</b><b>Google Agenda</b><b>ERP</b><b>CRM</b><b>E-mail</b>
        </p>
      </div>
    </section>

    <!-- Casos -->
    <section class="sec dark" id="casos">
      <div class="wrap">
        <p class="eyebrow light">Casos reais, com nome</p>
        <h2>O que mudou para quem já usa</h2>
        <p class="note light">Números medidos pelos próprios clientes.</p>
        <div class="cases">
          {cases.map((c) => (
            <article class="case reveal">
              <header>
                <span class={`logo-tile ${c.tile}`}><Image src={c.logo} alt={`Logo ${c.client}`} height={96} /></span>
                <div><h3>{c.client}</h3><p>{c.sector}</p></div>
              </header>
              <div class="results">
                {c.results.map((r) => (
                  <div><b>{r.value}</b><small>{r.label}</small></div>
                ))}
              </div>
              <dl class="ba">
                <div><dt>Como era</dt><dd>{c.before}</dd></div>
                <div><dt>O que a IA faz</dt><dd>{c.after}</dd></div>
                <div><dt>O que continua com a pessoa</dt><dd>{c.stays}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Método -->
    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">Do primeiro contato à IA rodando</p>
        <h2>Três fases. Você sabe o valor antes de começar.</h2>
        <ol class="phases">
          {phases.map((s) => (
            <li class="reveal">
              <span class="ph-n">{s.n}</span>
              <span class="ph-tag">{s.tag}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Comparação -->
    <section class="sec soft">
      <div class="wrap narrow">
        <p class="eyebrow">Por que a Etter</p>
        <h2>Não é mais uma agência de IA</h2>
        <div class="vs reveal">
          <div class="vs-head"><span>Agência comum</span><span>Etter</span></div>
          {compare.map((c) => (
            <div class="vs-row">
              <p class="them">{c.them}</p>
              <p class="us">{c.us}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quem sou eu -->
    <section class="sec about" id="enzo">
      <div class="wrap about-grid">
        <div class="about-photo">
          <Image src={enzoSf} alt="Enzo Vaccaro em San Francisco" widths={[480, 800]} sizes="(min-width: 900px) 420px, 90vw" />
          <span class="photo-tag">San Francisco, Vale do Silício</span>
        </div>
        <div>
          <p class="eyebrow light">Quem vai cuidar do seu projeto</p>
          <h2>Prazer, eu sou o Enzo.</h2>
          <p>
            Sou o fundador da Etter e quem constrói cada projeto. Trabalho com agentes de inteligência artificial e
            automação de processos para empresas brasileiras — do atendimento no WhatsApp a sistemas internos.
          </p>
          <p>
            Passei dois meses em San Francisco, no Vale do Silício. O que mais trouxe de lá não foi a parte técnica:
            foi entender que um projeto de IA se prova <strong>depois</strong> da entrega, quando ele precisa funcionar todo dia na operação real.
          </p>
          <p>
            Por isso eu não vendo pacote pronto. Cada projeto começa entendendo como a sua empresa trabalha hoje, e é
            montado em cima disso.
          </p>
          <ul class="facts">
            <li><b>Direto comigo</b><span>sem vendedor no meio</span></li>
