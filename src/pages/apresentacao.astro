      </div>
    </section>

    <footer class="foot">
      <div class="wrap">© 2026 Etter · Automação com inteligência artificial · <a href="/">etter.app.br</a></div>
    </footer>

    <!-- Botão fixo no celular -->
    <a href={WA} target="_blank" rel="noopener" class="sticky-wa" id="sticky" aria-label="Falar com o Enzo no WhatsApp">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={waIcon}/></svg>
      Conversar com o Enzo
    </a>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Entrada suave das seções
      const els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((e) => e.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }),
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((e) => io.observe(e));
      }

      // Conversa do celular aparecendo mensagem por mensagem
      const chat = document.getElementById('chat');
      if (chat && !reduce) {
        chat.classList.add('play');
        const msgs = [...chat.querySelectorAll('.msg')];
        const typing = chat.querySelector('.typing') as HTMLElement;
        const status = document.querySelector('.status') as HTMLElement;
        const delays = [400, 1500, 1200, 1500];
        let t = 0;
        msgs.forEach((m, i) => {
          const isOut = m.classList.contains('out');
          if (isOut) {
            setTimeout(() => { typing.classList.add('on'); status.textContent = 'digitando...'; }, t + 200);
          }
          t += delays[i] + (isOut ? 900 : 0);
          setTimeout(() => {
            typing.classList.remove('on');
            status.textContent = 'online agora';
            m.classList.add('show');
          }, t);
        });
        setTimeout(() => document.querySelectorAll('.float').forEach((f) => f.classList.add('show')), t + 400);
      } else {
        document.querySelectorAll('.float').forEach((f) => f.classList.add('show'));
      }

      // Calculadora do custo do trabalho repetido
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const brl = (v: number) => 'R$ ' + (Math.round(v / 100) * 100).toLocaleString('pt-BR');
      function calc() {
        const p = +$('i-p').value, h = +$('i-h').value, c = +$('i-c').value;
        const hourly = c / 176;
        const monthHours = p * h * 4.33;
        $('o-p').textContent = String(p);
        $('o-h').textContent = h + ' h';
        $('o-c').textContent = brl(c);
        $('r-y').textContent = brl(monthHours * hourly * 12);
        $('r-h').textContent = Math.round(monthHours).toLocaleString('pt-BR') + ' horas por mês';
      }
      ['i-p', 'i-h', 'i-c'].forEach((id) => $(id)?.addEventListener('input', calc));
      calc();

      // Botão fixo some no topo e no fim da página
      const sticky = document.getElementById('sticky');
      const final = document.querySelector('.final');
      const onScroll = () => {
        const nearEnd = final ? final.getBoundingClientRect().top < window.innerHeight : false;
        sticky?.classList.toggle('on', window.scrollY > 600 && !nearEnd);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>

